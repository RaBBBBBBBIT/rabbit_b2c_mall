# ===== 环境变量模板（开源示例）=====
# 使用方法：cp .env.example .env，然后填入你自己的值
# .env 已被 .gitignore 忽略，不会提交到仓库

# Nacos 注册中心 / 配置中心地址
# 本地单机 Nacos 默认：localhost:8848；生产/自建填你的实际地址
NACOS_SERVER_ADDR=localhost:8848
# Nacos 命名空间 ID，公共/默认环境留空即可
NACOS_NAMESPACE=

# shop 服务端口
SHOP_SERVER_PORT=8081
# SQLite 数据库连接地址
SHOP_DB_URL=jdbc:sqlite:./b2c_mall_shop.db

# gateway 服务端口
GATEWAY_SERVER_PORT=8080

# employee 服务端口
EMPLOYEE_SERVER_PORT=8082
# SQLite 数据库连接地址
EMPLOYEE_DB_URL=jdbc:sqlite:./b2c_mall_employee.db

# Redis 地址（本地单机默认 localhost:6379）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# 头像地址
DEFAULT_AVATAR_URL=

# JWT 签名密钥和内部服务调用密钥（请在本地 .env 中换成随机长密钥）
JWT_TOKEN_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_TTL_SECONDS=86400
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-random-internal-token

# 新增业务服务端口与 SQLite 文件
PRODUCT_SERVER_PORT=8083
PRODUCT_DB_URL=jdbc:sqlite:./b2c_mall_product.db
ORDER_SERVER_PORT=8084
ORDER_DB_URL=jdbc:sqlite:./b2c_mall_order.db
PRODUCT_SERVICE_URL=http://localhost:8083
EMPLOYEE_SERVICE_URL=http://localhost:8082
