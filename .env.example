# ===== 环境变量模板（开源示例）=====
# 使用方法：cp .env.example .env，然后填入你自己的值
# .env 已被 .gitignore 忽略，不会提交到仓库

# Nacos 注册中心 / 配置中心地址
# 本地单机 Nacos 默认：localhost:8848；生产/自建填你的实际地址
NACOS_SERVER_ADDR=localhost:8848
# Nacos 命名空间 ID，公共/默认环境留空即可
NACOS_NAMESPACE=

# shop 服务端口
SHOP_SERVER_PORT=8081
# SQLite 数据库连接地址
SHOP_DB_URL=jdbc:sqlite:./b2c_mall_shop.db

# gateway 服务端口
GATEWAY_SERVER_PORT=8080
